[global]
# Display
follow = mouse
width = 350
height = 100
origin = top-right
offset = 35x35
indicate_hidden = yes
notification_limit = 5
gap_size = 12
padding = 12
horizontal_padding = 20
frame_width = 1
sort = no

# Progress bar
progress_bar = true
progress_bar_frame_width = 0
progress_bar_height = 8
progress_bar_corner_radius = 4
progress_bar_min_width = 150
progress_bar_max_width = 320

# Colors
foreground = "#cdd6f4"      # text
frame_color = "#89b4fa"     # blue
separator_color = frame
highlight = "#89b4fa"       # blue

# Text
font = JetBrainsMono Nerd Font 10
markup = full
format = "<big><b>%s</b></big>\n%b"
alignment = left
vertical_alignment = center
show_age_threshold = -1
hide_duplicate_count = false

# Icon
icon_position = left
min_icon_size = 54
max_icon_size = 80
icon_path = /usr/share/icons/Papirus-Dark/status/96:/usr/share/icons/Papirus-Dark/status/symbolic
icon_corner_radius = 6

# Misc/Advanced
dmenu = rofi --show drun --prompt 'Open with'
corner_radius = 10

# Mouse
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[urgency_low]
background = "#1e1e2e"      # base
foreground = "#cdd6f4"      # text
timeout = 3

[urgency_normal]
background = "#1e1e2e"      # base
foreground = "#cdd6f4"      # text
timeout = 8

[urgency_critical]
background = "#1e1e2e"      # base
foreground = "#cdd6f4"      # text
frame_color = "#fab387"     # peach
highlight = "#fab387, #fab387"
timeout = 0

# Rules
[fullscreen_delay_everything]
fullscreen = delay

[fullscreen_show_critical]
msg_urgency = critical
fullscreen = show
