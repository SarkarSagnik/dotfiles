{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo.png",
        "width": 25,
        "height": 10
    },
    "display": {
        "separator": " │ "
    },
    "modules": [
        {
            "type": "host",
            "key": "╭─󰌢",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "├─󰻠",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "├─󰍛",
            "keyColor": "green"
        },

        {
            "type": "command",
            "key": "├─",
            "keyColor": "yellow",
            "text": "df -hT / | awk 'NR==2 {print $6 \" used (\" $3 \"/\" $2 \") [\" $2 \"] (Internal)\"}'"
        },
        {
            "type": "command",
            "key": "├─",
            "keyColor": "magenta",
            "text": "if findmnt /mnt/CRUCIAL > /dev/null 2>&1; then df -hT /mnt/CRUCIAL | awk 'NR==2 {print $6 \" used (\" $3 \"/\" $2 \") [\" $2 \"] (External)\"}'; fi"
        },

        {
            "type": "memory",
            "key": "├─󰑭",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "╰─󰍹",
            "keyColor": "green"
        },
        "break",

        {
            "type": "title",
            "key": "╭─",
            "format": "{1}@{2}",
            "keyColor": "blue"
        },
        {
            "type": "os",
            "key": "├─󰣇",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "├─",
            "format": "{1} {2}",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "├─󰏖",
            "keyColor": "blue"
        },
        {
            "type": "command",
            "key": "├─󱦟",
            "keyColor": "blue",
            "text": "echo \"$(($(($(date +%s)-$(stat -c %W /)) / 86400))) days since install\""
        },
        {
            "type": "uptime",
            "key": "╰─󰅐",
            "keyColor": "blue"
        }
    ]
}
