#!/usr/bin/env bash
set -euo pipefail

# Temperature for night mode
TEMP=4500
if ! command -v hyprsunset &> /dev/null; then echo "hyprsunset not found"; exit 1; fi
if ! command -v notify-send &> /dev/null; then echo "notify-send not found"; exit 1; fi

# Check if hyprsunset is already running
if pgrep -x "hyprsunset" >/dev/null; then
    # Turn off nightlight
    pkill hyprsunset
    notify-send "Nightlight Off" "Color temperature restored to normal."
else
    # Turn on nightlight with desired warmth
    hyprsunset --temperature "$TEMP" &
    notify-send "Nightlight On" "Warm color temperature set to ${TEMP}K."
fi

