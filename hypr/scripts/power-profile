#!/bin/bash
# Power profile switcher using Wofi (Fedora-compatible version)

profiles=$(/usr/bin/powerprofilesctl list | awk '
/^\s*[* ]\s*[a-zA-Z0-9\-]+:$/ {
  gsub(/^[*[:space:]]+|:$/,"");
  print
}')
current=$(/usr/bin/powerprofilesctl get)

chosen=$(echo "$profiles" | rofi -dmenu \
  -p "Power Profile (current: $current)" \
  --width 480 \
  --height 320 \
  --hide-scroll \
  --prompt "Select profile:")

if [[ -n "$chosen" && "$chosen" != "$current" ]]; then
    /usr/bin/powerprofilesctl set "$chosen"
    new_profile=$(/usr/bin/powerprofilesctl get)
    notify-send "⚙️ Power Profile" "Switched to: $new_profile"
fi

