#!/usr/bin/env bash

# Night light settings
TEMP=4500       # color temperature (K)
GAMMA=0.9       # gamma (decimal)

# Check if wlsunset is running
if pgrep -x "wlsunset" >/dev/null; then
    pkill -x wlsunset
    notify-send "Nightlight Off" "Color temperature restored to normal."
else
    # kill any stray wlsunset instances
    pkill -x wlsunset >/dev/null 2>&1

    # Start wlsunset normally (it always goes to background automatically)
    wlsunset -t "$TEMP" -g "$GAMMA" &

    notify-send "Nightlight On" "Nightlight set to ${TEMP}K (gamma ${GAMMA})."
fi

